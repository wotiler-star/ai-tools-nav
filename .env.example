# ===== 数据库 =====
# 开发（SQLite，零配置）：
DATABASE_URL="file:./dev.db"
# 生产（PostgreSQL，Docker Compose / 1Panel / Coolify / Vercel 用这个）：
# DATABASE_URL="postgresql://ainav:ainav123@db:5432/ainav?schema=public"

# ===== Auth.js =====
# 会话密钥：生产务必替换为强随机值（执行 `openssl rand -base64 32` 生成）
AUTH_SECRET="change-me-to-a-long-random-string"

# 站点公开地址（生产填你的域名，如 https://ai.example.com）
NEXTAUTH_URL="http://localhost:3000"
