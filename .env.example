# ===== 数据库 =====
# 开发（SQLite，零配置）：
DATABASE_URL="file:./dev.db"
# 生产（PostgreSQL，Docker Compose / 1Panel / Coolify / Vercel 用这个）：
# DATABASE_URL="postgresql://ainav:ainav123@db:5432/ainav?schema=public"

# ===== Auth.js =====
# 会话密钥：生产务必替换为强随机值（执行 `openssl rand -base64 32` 生成）
AUTH_SECRET="change-me-to-a-long-random-string"

# GitHub OAuth 登录（可选）：
#  1) 在 GitHub -> Settings -> Developer settings -> OAuth Apps 新建应用，
#     Authorization callback URL 填 https://你的域名/api/auth/callback/github
#  2) 把生成的 Client ID / Client Secret 填到下面
#  3) 并把 NEXT_PUBLIC_GITHUB_LOGIN 改为 true
# 不配置时，登录弹窗里的 GitHub 按钮会提示「暂未开放」
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
NEXT_PUBLIC_GITHUB_LOGIN="false"

# 站点公开地址（生产必填，含 https://，如 https://ai.example.com）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js 回调地址（生产与上方保持一致）
NEXTAUTH_URL="http://localhost:3000"

# ===== 搜索引擎站长验证（可选，填入对应平台给的验证码/ID）=====
# Google Search Console 验证元标签内容
# GOOGLE_SITE_VERIFICATION="xxxxxxx"
# 百度站长验证
# BAIDU_SITE_VERIFICATION="xxxxxxx"
# Bing / Yandex（填 content 值）
# BING_SITE_VERIFICATION="xxxxxxx"
# YANDEX_SITE_VERIFICATION="xxxxxxx"
